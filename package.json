{
  "name": "pyor-review",
  "version": "0.5.1",
  "description": "Open your working git changes as an AI-reviewed local pre-PR review in the Pyor desktop app. Works with any coding agent.",
  "type": "module",
  "bin": {
    "pyor-review": "plugins/pyor/scripts/pyor-ai-review.mjs",
    "pyor-local-review": "plugins/pyor/scripts/pyor-local-review.mjs"
  },
  "files": [
    "plugins/pyor/scripts",
    "plugins/pyor/skills"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node plugins/pyor/scripts/pyor-ai-review.mjs --selftest && node plugins/pyor/scripts/pyor-local-review.mjs --selftest",
    "prepublishOnly": "npm test",
    "version": "node scripts/sync-version.mjs && git add plugins/pyor/.claude-plugin/plugin.json .claude-plugin/marketplace.json"
  },
  "keywords": [
    "pyor",
    "code-review",
    "pull-request",
    "git",
    "agent-skills"
  ],
  "author": {
    "name": "Pyor",
    "url": "https://github.com/Pyor-review"
  },
  "homepage": "https://pyor.review",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pyor-review/pyor-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Pyor-review/pyor-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
